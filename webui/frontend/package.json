{
  "name": "fwalizer-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:dryrun": "node --test tests/dryrun-state.test.mjs",
    "test:dashboard": "node --test tests/dashboard-observation.test.mjs",
    "test:alerts": "node --test --test-timeout=30000 tests/alerts-load.test.mjs",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:delete": "node --test tests/delete-confirm.test.mjs",
    "test:logs": "node --test tests/logs-stream.test.mjs",
    "test:state": "node --test tests/p316-state.test.mjs",
    "test:import": "node --test --test-timeout=30000 tests/import-presence.test.mjs"
  },
  "dependencies": {
    "naive-ui": "^2.45.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
