# FWAlizer Docker Compose 示例
# 复制此文件为 docker-compose.yml 并根据需要修改
#
# ⚠️ 默认推荐 WebUI 模式（浏览器可视化管理，配置存于 SQLite）；
#    .env 模式为备用/进阶/极简模式（挂载 .env，见下方注释）。

services:
  fwalizer:
    # 使用预构建镜像（推荐）
    image: ghcr.io/alcaprophet/fwalizer:latest
    # 或本地构建：
    # build:
    #   context: .
    #   dockerfile: build/Dockerfile
    #   args:
    #     VERSION: local

    container_name: fwalizer

    # ---- 环境变量 ----
    environment:
      # 数据目录路径（可选，默认按平台自动选择）
      # 在 Docker 中建议显式指定，避免依赖 HOME 目录
      - FWALIZER_DATA_DIR=/app/data

      # 同步间隔（可选，默认 5m）
      - INTERVAL=5m

      # 同步全局开关（可选，默认 true；false 时启动不执行同步）
      # - SYNC_ENABLED=true

      # 自定义 DNS 服务器（可选，默认 223.5.5.5）
      # - DNS=223.5.5.5

      # WebUI 端口（可选，默认 60200）
      - WEBUI_PORT=60200

      # 容器内需监听所有接口，才能接收 Docker 端口映射的请求
      - WEBUI_HOST=0.0.0.0

      # 日志级别（可选，默认 info）
      - LOG_LEVEL=info

    # ---- 端口映射 ----
    # WebUI 模式：默认发布到宿主机所有接口；仅同机反向代理访问可改为 127.0.0.1:60200:60200
    ports:
      - "60200:60200"

    # ---- 卷挂载 ----
    volumes:
      # 数据持久化（SQLite 数据库存储于此）
      - fwalizer_data:/app/data

      # .env 模式：挂载配置文件（二选一，与上方 ports 互斥）
      # - ./config/.env:/app/.env:ro

    # ---- 健康检查 ----
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q -O /dev/null http://localhost:60200/api/health 2>/dev/null || pgrep fwalizer || exit 1",
        ]
      interval: 30s
      timeout: 3s
      start_period: 10s
      retries: 3

    # ---- 重启策略 ----
    restart: unless-stopped

    # ---- 运行模式说明 ----
    # 默认（上方配置）为 WebUI 模式（推荐）：浏览器访问 http://127.0.0.1:60200 完成全部配置
    # .env 模式（备用/进阶）：取消注释下方 volumes 中的 .env 挂载并注释 ports，
    # 需在 ./config/.env 提供 TARGETS/RULES/凭据等（模板见 .env.example）

volumes:
  fwalizer_data:
    driver: local
