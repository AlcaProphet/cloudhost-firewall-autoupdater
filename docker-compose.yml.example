services:
  fwalizer:
    image: ghcr.io/alcaprophet/fwalizer:3.0.2
    platform: linux/amd64
    container_name: fwalizer
    restart: unless-stopped
    stop_grace_period: 5m
    environment:
      FWALIZER_DATA_DIR: /app/data
      WEBUI_HOST: 0.0.0.0
      WEBUI_PORT: "60200"
    ports:
      - target: 60200
        published: "60200"
        host_ip: 127.0.0.1
    volumes:
      - fwalizer_data:/app/data
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  fwalizer_data:
    driver: local

# 可选调整（直接编辑本文件）
# image：选择其他镜像标签或本地镜像。
# ports.published / ports.host_ip：设置宿主机端口和绑定地址，仅绑定受信任接口。
# ports.target / environment.WEBUI_PORT：修改容器端口时同步调整这两个字段。
# stop_grace_period：设置 Docker 强制终止前的等待时间。
