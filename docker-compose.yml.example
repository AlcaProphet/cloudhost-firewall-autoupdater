# FWAlizer Docker Compose 示例
# 复制此文件为 docker-compose.yml 并根据需要修改
#
# FWAlizer 只有一种运行形态：WebUI 单二进制 + SQLite。
# 容器内不需要图形桌面，通过浏览器访问 WebUI 完成全部业务配置。

services:
  fwalizer:
    # 使用预构建镜像（推荐）
    image: ghcr.io/alcaprophet/fwalizer:latest
    # 或本地构建：
    # build:
    #   context: .
    #   dockerfile: build/Dockerfile

    container_name: fwalizer

    # ---- 部署环境变量（全部仅三个） ----
    # 业务配置（凭据、目标、规则、TAG、间隔、DNS、日志级别、告警）全部由
    # WebUI 写入 SQLite，不存在环境变量 override。
    environment:
      # 数据目录路径（SQLite 与 pidfile；镜像已预置并授权给 appuser）
      - FWALIZER_DATA_DIR=/app/data

      # 容器内需监听所有接口，才能接收 Docker 端口映射的请求
      - WEBUI_HOST=0.0.0.0

      # WebUI 监听端口（默认 60200）
      - WEBUI_PORT=60200

    # ---- 端口映射 ----
    # 默认发布到宿主机所有接口；仅同机反向代理访问可改为 127.0.0.1:60200:60200
    ports:
      - "60200:60200"

    # ---- 卷挂载 ----
    volumes:
      # 数据持久化（SQLite 数据库存储于此）
      - fwalizer_data:/app/data

    # ---- 健康检查 ----
    # 只认 HTTP /api/health，不使用进程存活（pgrep）fallback：
    # 进程存活但 WebUI 不可用时必须判为 unhealthy。
    # 若修改上面的 WEBUI_PORT，必须同步修改这里的端口。
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q -O /dev/null \"http://127.0.0.1:${WEBUI_PORT:-60200}/api/health\" || exit 1",
        ]
      interval: 30s
      timeout: 3s
      start_period: 10s
      retries: 3

    # ---- 重启策略 ----
    restart: unless-stopped

    # ---- 访问 ----
    # 浏览器访问 http://127.0.0.1:60200 完成全部配置。
    # 默认只监听容器内 0.0.0.0；宿主机暴露范围由上方 ports 决定。

volumes:
  fwalizer_data:
    driver: local
